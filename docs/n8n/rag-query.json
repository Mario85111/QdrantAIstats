{
  "name": "rag-query",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rag-query",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-320, 300],
      "id": "b2000000-0000-4000-8000-000000000001",
      "name": "Webhook: pytanie",
      "webhookId": "b2000000-0000-4000-8000-0000000000ff"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "q1",
              "name": "question",
              "value": "={{ $json.body.question }}",
              "type": "string"
            },
            {
              "id": "q2",
              "name": "conversation_id",
              "value": "={{ $json.body.conversation_id || 'brak' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-100, 300],
      "id": "b2000000-0000-4000-8000-000000000002",
      "name": "Kontrakt wejscia"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.question }}",
        "options": {
          "systemMessage": "Jestes asystentem odpowiadajacym wylacznie na podstawie dokumentow z bazy wiedzy.\n\nZasady:\n1. Zanim odpowiesz, uzyj narzedzia baza_wiedzy do wyszukania fragmentow.\n2. Odpowiadaj po polsku, zwiezle i konkretnie.\n3. Jesli w znalezionych fragmentach nie ma odpowiedzi, powiedz wprost: \"Nie znalazlem tego w bazie wiedzy\". Nie zgaduj i nie uzupelniaj z wlasnej wiedzy.\n4. Na koncu odpowiedzi wymien nazwy plikow, z ktorych korzystales."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [160, 300],
      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "Agent RAG",
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "model": "deepseek/deepseek-flash-latest",
        "options": {
          "temperature": 0.2
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [60, 540],
      "id": "b2000000-0000-4000-8000-000000000004",
      "name": "Model czatu (OpenRouter)"
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Kontrakt wejscia').first().json.conversation_id }}",
        "contextWindowLength": 10
      },
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [260, 540],
      "id": "b2000000-0000-4000-8000-000000000005",
      "name": "Pamiec rozmowy"
    },
    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolName": "baza_wiedzy",
        "toolDescription": "Przeszukuje baze wiedzy zbudowana z dokumentow wgranych przez operatora. Uzyj do kazdego pytania merytorycznego.",
        "qdrantCollection": {
          "__rl": true,
          "value": "ragdcs",
          "mode": "id"
        },
        "topK": 5,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1.1,
      "position": [460, 540],
      "id": "b2000000-0000-4000-8000-000000000006",
      "name": "Qdrant: wyszukiwanie",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "model": "baai/bge-m3",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [460, 760],
      "id": "b2000000-0000-4000-8000-000000000007",
      "name": "Embeddingi bge-m3 (OpenRouter)",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'done', answer: $json.output, sources: [] }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [520, 200],
      "id": "b2000000-0000-4000-8000-000000000008",
      "name": "Odpowiedz: sukces"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'error', message: $json.error?.message || 'Blad agenta' }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [520, 380],
      "id": "b2000000-0000-4000-8000-000000000009",
      "name": "Odpowiedz: blad"
    },
    {
      "parameters": {
        "content": "## Odpowiadanie na pytania z bazy wiedzy\n\nWebhook synchroniczny - aplikacja mierzy czas odpowiedzi po swojej stronie.\n\nPamiec rozmowy jest ULOTNA (ginie przy restarcie n8n).\nZrodlem prawdy o historii jest arkusz chat_messages po stronie aplikacji.\n\nModel czatu podmienisz w wezle \"Model czatu (OpenRouter)\" -\nID modelu to zwykly parametr, mozesz testowac rozne pod katem polszczyzny.",
        "height": 260,
        "width": 480
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-340, -20],
      "id": "b2000000-0000-4000-8000-00000000000a",
      "name": "Notatka: cel workflow"
    }
  ],
  "connections": {
    "Webhook: pytanie": {
      "main": [[{ "node": "Kontrakt wejscia", "type": "main", "index": 0 }]]
    },
    "Kontrakt wejscia": {
      "main": [[{ "node": "Agent RAG", "type": "main", "index": 0 }]]
    },
    "Agent RAG": {
      "main": [
        [{ "node": "Odpowiedz: sukces", "type": "main", "index": 0 }],
        [{ "node": "Odpowiedz: blad", "type": "main", "index": 0 }]
      ]
    },
    "Model czatu (OpenRouter)": {
      "ai_languageModel": [[{ "node": "Agent RAG", "type": "ai_languageModel", "index": 0 }]]
    },
    "Pamiec rozmowy": {
      "ai_memory": [[{ "node": "Agent RAG", "type": "ai_memory", "index": 0 }]]
    },
    "Qdrant: wyszukiwanie": {
      "ai_tool": [[{ "node": "Agent RAG", "type": "ai_tool", "index": 0 }]]
    },
    "Embeddingi bge-m3 (OpenRouter)": {
      "ai_embedding": [[{ "node": "Qdrant: wyszukiwanie", "type": "ai_embedding", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
