{
  "name": "rag-ingest",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rag-ingest",
        "responseMode": "responseNode",
        "options": {
          "binaryPropertyName": "file",
          "rawBody": false
        }
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-360, 300],
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Webhook: wsad pliku",
      "webhookId": "a1000000-0000-4000-8000-0000000000ff"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "doc_id",
              "value": "={{ $execution.id }}-{{ Date.now() }}",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "filename",
              "value": "={{ $binary.file.fileName }}",
              "type": "string"
            },
            {
              "id": "f3",
              "name": "mime",
              "value": "={{ $binary.file.mimeType }}",
              "type": "string"
            },
            {
              "id": "f4",
              "name": "ingested_at",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-140, 300],
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Kontrakt wejscia"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose", "version": 2 },
                "conditions": [
                  {
                    "id": "c1",
                    "leftValue": "={{ $json.mime }}",
                    "rightValue": "pdf",
                    "operator": { "type": "string", "operation": "contains" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "pdf"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose", "version": 2 },
                "conditions": [
                  {
                    "id": "c2",
                    "leftValue": "={{ $json.mime }}",
                    "rightValue": "spreadsheet",
                    "operator": { "type": "string", "operation": "contains" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "xlsx"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose", "version": 2 },
                "conditions": [
                  {
                    "id": "c3",
                    "leftValue": "={{ $json.mime }}",
                    "rightValue": "csv",
                    "operator": { "type": "string", "operation": "contains" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "csv"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "loose", "version": 2 },
                "conditions": [
                  {
                    "id": "c4",
                    "leftValue": "={{ $json.mime }}",
                    "rightValue": "wordprocessingml",
                    "operator": { "type": "string", "operation": "contains" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "docx"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "tekst"
        }
      },
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [80, 300],
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Routing po typie pliku"
    },
    {
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "file",
        "options": {}
      },
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [340, 60],
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Ekstrakcja PDF",
      "retryOnFail": true,
      "maxTries": 2
    },
    {
      "parameters": {
        "operation": "xlsx",
        "binaryPropertyName": "file",
        "options": {}
      },
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [340, 240],
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Ekstrakcja XLSX"
    },
    {
      "parameters": {
        "operation": "csv",
        "binaryPropertyName": "file",
        "options": {}
      },
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [340, 420],
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Ekstrakcja CSV"
    },
    {
      "parameters": {
        "operation": "text",
        "binaryPropertyName": "file",
        "destinationKey": "text",
        "options": {}
      },
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [340, 780],
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Ekstrakcja TXT i MD"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'error', reason: 'unsupported_type', message: 'DOCX nie jest wspierany natywnie przez wezel Extract from File. Zapisz plik jako PDF lub TXT.', filename: $json.filename }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [340, 600],
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Odpowiedz: DOCX niewspierany"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "t1",
              "name": "text",
              "value": "={{ $json.text || $json.data || JSON.stringify($json) }}",
              "type": "string"
            },
            {
              "id": "t2",
              "name": "doc_id",
              "value": "={{ $('Kontrakt wejscia').first().json.doc_id }}",
              "type": "string"
            },
            {
              "id": "t3",
              "name": "filename",
              "value": "={{ $('Kontrakt wejscia').first().json.filename }}",
              "type": "string"
            },
            {
              "id": "t4",
              "name": "ingested_at",
              "value": "={{ $('Kontrakt wejscia').first().json.ingested_at }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [600, 300],
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "Ujednolicony tekst"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "e1",
              "leftValue": "={{ $json.text.trim().length }}",
              "rightValue": 20,
              "operator": { "type": "number", "operation": "gte" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [820, 300],
      "id": "a1000000-0000-4000-8000-00000000000a",
      "name": "Czy jest tekst"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'error', reason: 'no_text', message: 'Plik nie zawiera warstwy tekstowej (skan bez OCR)', filename: $json.filename }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1060, 480],
      "id": "a1000000-0000-4000-8000-00000000000b",
      "name": "Odpowiedz: brak tekstu"
    },
    {
      "parameters": {
        "mode": "insert",
        "qdrantCollection": {
          "__rl": true,
          "value": "rag_docs",
          "mode": "id"
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1.1,
      "position": [1060, 140],
      "id": "a1000000-0000-4000-8000-00000000000c",
      "name": "Qdrant: zapis wektorow",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "model": "baai/bge-m3",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [1000, 700],
      "id": "a1000000-0000-4000-8000-00000000000d",
      "name": "Embeddingi bge-m3 (OpenRouter)",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsonMode": "expressionData",
        "jsonData": "={{ $json.text }}",
        "options": {
          "metadata": {
            "metadataValues": [
              { "name": "doc_id", "value": "={{ $json.doc_id }}" },
              { "name": "filename", "value": "={{ $json.filename }}" },
              { "name": "ingested_at", "value": "={{ $json.ingested_at }}" }
            ]
          }
        },
        "textSplittingMode": "custom"
      },
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1,
      "position": [1220, 700],
      "id": "a1000000-0000-4000-8000-00000000000e",
      "name": "Loader dokumentu"
    },
    {
      "parameters": {
        "chunkSize": 1000,
        "chunkOverlap": 150,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [1220, 880],
      "id": "a1000000-0000-4000-8000-00000000000f",
      "name": "Podzial na chunki"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'done', doc_id: $('Ujednolicony tekst').first().json.doc_id, filename: $('Ujednolicony tekst').first().json.filename, chunks: $items().length, execution_id: $execution.id }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1320, 140],
      "id": "a1000000-0000-4000-8000-000000000010",
      "name": "Odpowiedz: sukces"
    },
    {
      "parameters": {
        "content": "## Wsad dokumentu do zasobu wektorowego\n\nWebhook jest SYNCHRONICZNY - odpowiedz 200 wraca dopiero po zapisie punktow w Qdrancie.\nDzieki temu status \"w zasobie\" w aplikacji nie klamie (ryzyko R-2 w SCOPE.md).\n\nDOCX nie jest wspierany natywnie - patrz galaz \"docx\".",
        "height": 220,
        "width": 460
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-380, 40],
      "id": "a1000000-0000-4000-8000-000000000011",
      "name": "Notatka: cel workflow"
    },
    {
      "parameters": {
        "content": "## Embeddingi przez OpenRouter\n\nWezel \"Embeddings OpenAI\" uzywa credentiala OpenAI, w ktorym\nBase URL ustawiono na https://openrouter.ai/api/v1\na klucz to klucz OpenRoutera.\n\nModel: baai/bge-m3 - 1024 wymiary, wielojezyczny.\nWymiar kolekcji w Qdrancie MUSI wynosic 1024.",
        "height": 240,
        "width": 420
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [960, 980],
      "id": "a1000000-0000-4000-8000-000000000012",
      "name": "Notatka: embeddingi"
    }
  ],
