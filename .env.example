# Skopiuj do .env.local i uzupełnij. .env.local NIGDY nie trafia do repo.

# --- Qdrant (VPS) ---
QDRANT_URL=https://twoj-vps:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=ragdcs

# --- n8n (adresy produkcyjne webhooków, po aktywacji workflow) ---
INGEST_WEBHOOK_URL=https://twoj-n8n/webhook/rag-ingest
CHAT_WEBHOOK_URL=https://twoj-n8n/webhook/rag-query

# --- Google Sheets (magazyn pomiarów; opcjonalny w M0) ---
# ID skoroszytu z adresu: docs.google.com/spreadsheets/d/<TO_ID>/edit
GOOGLE_SHEETS_ID=
# Ścieżka do pliku klucza konta serwisowego. Trzymaj go POZA katalogiem projektu.
GOOGLE_SERVICE_ACCOUNT_JSON=C:/sekrety/qdrantaistats-service-account.json
